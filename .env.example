# Ishara Connect Environment Variables
# Copy this file to .env and fill in your values
# NOTE: .env is git-ignored and will NEVER be pushed to GitHub!

# Supabase Database & Auth Configuration
# Get these from https://supabase.com/dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional Backend API URL
VITE_API_URL=http://localhost:5000

# ZEGOCLOUD 1:1 Video Calling Credentials
# Obtain from https://console.zegocloud.com/
# AppID is a number (e.g. 123456789)
# ServerSecret is a 32-character hex string
VITE_ZEGO_APP_ID=
VITE_ZEGO_SERVER_SECRET=

# Optional: Gemini API Key for AI fallback classification
# Get your key from https://makersuite.google.com/app/apikey
# VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Custom STUN servers (comma-separated)
# VITE_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Optional: Enable debug logging
# VITE_DEBUG=false